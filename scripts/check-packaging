#!/bin/bash
# Package build smoke test (plan Task 27).
#
# Builds the golang-marked rpm and deb from the COMMITTED tree and asserts
# the packaged payload:
#   - the release/version visibly marks the golang build;
#   - the package is architecture-specific (not noarch / Architecture: all);
#   - /usr/bin/journalpump is the Go ELF binary;
#   - the shipped unit is BYTE-IDENTICAL to the in-tree journalpump.unit
#     (the plan requires the unit be unchanged);
#   - the retained payload and the Debian postinst match expected manifests;
#   - the shipped default config is present, byte-identical to
#     journalpump.default.json, and marked %config(noreplace) (rpm) / a dpkg
#     conffile (deb) so operator edits survive an upgrade;
#   - rpmlint / lintian report no errors beyond the narrowly allowlisted,
#     documented diagnostics -- and a linter that fails to run to completion
#     (unexpected exit status, or a status that disagrees with its output)
#     also fails this check (see the linter-gate self-test).
#
# Both builds run in podman containers (a Fedora container for the rpm, a
# Debian container for the deb) so the check works on any host with podman.
# The Debian container installs ONLY the declared Build-Depends (notably
# golang-go from the distro, whose GOTOOLCHAIN=auto fetches the go.mod-pinned
# toolchain); no separate Go is injected.  The rpm target sources `git archive
# HEAD` and the deb runs from a git clone, so the check validates the
# committed tree only -- commit before running.
#
# The container scripts are passed as an argv (-c), not on stdin, because
# `make deb` invokes dch, which reads stdin; feeding the script on stdin
# would let dch swallow the assertions.
#
# Environment overrides:
#   RPM_IMAGE  (default registry.fedoraproject.org/fedora:latest)
#   DEB_IMAGE  (default docker.io/library/debian:trixie)
set -euo pipefail

cd "$(dirname "$0")/.."
repo=$PWD

if ! command -v podman >/dev/null; then
    echo "podman is required for check-packaging" >&2
    exit 1
fi

rpm_image=${RPM_IMAGE:-registry.fedoraproject.org/fedora:latest}
deb_image=${DEB_IMAGE:-docker.io/library/debian:trixie}

# ---------------------------------------------------------------------------
# Fail-closed linter gates.
#
# Each gate takes the linter's OUTPUT FILE and its EXIT STATUS and returns
# non-zero if the linter failed to run to completion (an unexpected exit
# status, a missing session banner, a processing failure, or a status that
# disagrees with the diagnostics seen) OR if it reported an E: line not on the
# narrow allowlist.  The allowlists name only the documented diagnostics; a
# negative-control self-test (below) proves each rejection path.
# ---------------------------------------------------------------------------

# rpmlint diagnostics that are inherent to the package and documented:
#   - spelling-error on the technology names systemd (Summary), journald and
#     logplex (description) -- rpmlint's dictionary false positives.
# There is no summary-too-long entry: the Summary is deliberately kept under
# rpmlint's 80-char limit (a user-approved divergence from the Python spec's
# 85-char wording), so that diagnostic no longer occurs.
RPM_E_ALLOW=": E: (spelling-error \('(systemd|journald|logplex)')"
# rpmlint exit statuses: 0 = no errors; 64 = one or more errors (where the
# allowlisted spelling false-positives put it).  Anything else (e.g. 2, the
# status for an unreadable package file) is a failed run.
RPM_ALLOWED_RC="0 64"
# The deb carries ONE allowlisted diagnostic:
#   - non-etc-file-marked-as-conffile: the default config is a dpkg conffile
#     (so operator edits survive install-over/upgrade, matching the RPM's
#     %config(noreplace)) but cannot live in /etc because the unchanged unit's
#     ExecStart names /var/lib/journalpump/journalpump.json (user decision
#     2026-10-12: keep the path unchanged).  lintian reports this as an E:.
DEB_E_ALLOW='non-etc-file-marked-as-conffile var/lib/journalpump/journalpump\.json'
# lintian exit statuses: 0 = no E: tags; 2 = one or more E: tags.  Anything
# else (1, or a usage/internal-error status) is a failed run.
DEB_ALLOWED_RC="0 2"

_rc_allowed() {
    # $1 exit status, $2 space-separated allowlist.
    case " $2 " in
        *" $1 "*) return 0 ;;
    esac
    return 1
}

_unexpected_e() {
    # $1 output file, $2 allow regex; prints the offending E: lines.
    grep -E '(^|[[:space:]])E: ' "$1" | grep -vE "$2" || true
}

_e_count() {
    # $1 output file; prints the number of E: lines (0 when there are none).
    grep -cE '(^|[[:space:]])E: ' "$1" || true
}

rpmlint_gate() {
    local out=$1 rc=$2 bad ecount
    if ! _rc_allowed "$rc" "$RPM_ALLOWED_RC"; then
        echo "rpmlint exited $rc (expected one of: $RPM_ALLOWED_RC); treating as a failed run" >&2
        return 1
    fi
    if ! grep -qF 'rpmlint session starts' "$out"; then
        echo "rpmlint did not run (no session banner); treating as failure" >&2
        return 1
    fi
    ecount=$(_e_count "$out")
    # The status must describe the output: rc 0 <-> no errors, rc 64 <-> errors.
    if { [ "$rc" = 0 ] && [ "$ecount" != 0 ]; } || { [ "$rc" = 64 ] && [ "$ecount" = 0 ]; }; then
        echo "rpmlint exit status $rc disagrees with $ecount E: line(s); treating as failure" >&2
        return 1
    fi
    bad=$(_unexpected_e "$out" "$RPM_E_ALLOW")
    if [ -n "$bad" ]; then
        echo "rpmlint reported unexpected errors:" >&2
        printf '%s\n' "$bad" >&2
        return 1
    fi
}

lintian_gate() {
    local out=$1 rc=$2 bad ecount
    if ! _rc_allowed "$rc" "$DEB_ALLOWED_RC"; then
        echo "lintian exited $rc (expected one of: $DEB_ALLOWED_RC); treating as a failed run" >&2
        return 1
    fi
    if grep -qE 'No packages selected|is not a Debian format archive|is not a readable file|internal error|Traceback' "$out"; then
        echo "lintian failed to process the package; treating as failure" >&2
        return 1
    fi
    ecount=$(_e_count "$out")
    # The status must describe the output: rc 0 <-> no E: tags, rc 2 <-> E: tags.
    if { [ "$rc" = 0 ] && [ "$ecount" != 0 ]; } || { [ "$rc" = 2 ] && [ "$ecount" = 0 ]; }; then
        echo "lintian exit status $rc disagrees with $ecount E: line(s); treating as failure" >&2
        return 1
    fi
    bad=$(_unexpected_e "$out" "$DEB_E_ALLOW")
    if [ -n "$bad" ]; then
        echo "lintian reported unexpected errors:" >&2
        printf '%s\n' "$bad" >&2
        return 1
    fi
}

selftest_gates() {
    local t
    t=$(mktemp)
    # allowlisted rpmlint output with its expected status passes
    cat >"$t" <<'EOF'
rpmlint session starts
journalpump.x86_64: E: spelling-error ('journald', '%description -l en_US journald -> journals')
journalpump.x86_64: E: spelling-error ('logplex', 'complex') and ('systemd', 'systems')
EOF
    rpmlint_gate "$t" 64 || { echo "gate self-test: allowlisted input rejected" >&2; rm -f "$t"; return 1; }
    # an unexpected E: must fail
    printf 'rpmlint session starts\nfoo.x86_64: E: unexpected-tag bar\n' >"$t"
    if rpmlint_gate "$t" 64; then echo "gate self-test: unexpected error accepted" >&2; rm -f "$t"; return 1; fi
    # summary-too-long is deliberately NOT allowlisted: it must fail
    printf "rpmlint session starts\nfoo.x86_64: E: summary-too-long a very long summary\n" >"$t"
    if rpmlint_gate "$t" 64; then echo "gate self-test: summary-too-long accepted" >&2; rm -f "$t"; return 1; fi
    # a linter that did not run (no banner) must fail
    printf 'rpmlint: internal error\n' >"$t"
    if rpmlint_gate "$t" 2; then echo "gate self-test: failed rpmlint run accepted" >&2; rm -f "$t"; return 1; fi
    # an abnormal termination (nonzero status without a diagnostic) must fail
    printf 'rpmlint session starts\n' >"$t"
    if rpmlint_gate "$t" 1; then echo "gate self-test: abnormal rpmlint termination accepted" >&2; rm -f "$t"; return 1; fi
    # a status that disagrees with the output (rc 0 but an E: present) must fail
    printf 'rpmlint session starts\nfoo.x86_64: E: unexpected-tag bar\n' >"$t"
    if rpmlint_gate "$t" 0; then echo "gate self-test: inconsistent rpmlint status accepted" >&2; rm -f "$t"; return 1; fi
    # lintian: an E: with its expected status must fail (not allowlisted)
    printf 'E: journalpump: bogus-tag foo\n' >"$t"
    if lintian_gate "$t" 2; then echo "gate self-test: lintian error accepted" >&2; rm -f "$t"; return 1; fi
    # lintian: the allowlisted conffile diagnostic (with its status) passes
    printf 'E: journalpump: non-etc-file-marked-as-conffile var/lib/journalpump/journalpump.json [conffiles:1]\n' >"$t"
    lintian_gate "$t" 2 || { echo "gate self-test: allowlisted lintian input rejected" >&2; rm -f "$t"; return 1; }
    # lintian: a processing failure must fail
    printf 'No packages selected.\n' >"$t"
    if lintian_gate "$t" 2; then echo "gate self-test: lintian processing failure accepted" >&2; rm -f "$t"; return 1; fi
    # lintian: an abnormal termination (nonzero status, no diagnostic) must fail
    printf 'running with root privileges is not recommended!\n' >"$t"
    if lintian_gate "$t" 1; then echo "gate self-test: abnormal lintian termination accepted" >&2; rm -f "$t"; return 1; fi
    # lintian: a status that disagrees with the output (rc 2, no E:) must fail
    printf 'W: probe: some-warning\n' >"$t"
    if lintian_gate "$t" 2; then echo "gate self-test: inconsistent lintian status accepted" >&2; rm -f "$t"; return 1; fi
    # lintian: a clean warnings-only run (rc 0) passes
    printf 'W: probe: some-warning\n' >"$t"
    lintian_gate "$t" 0 || { echo "gate self-test: clean lintian run rejected" >&2; rm -f "$t"; return 1; }
    rm -f "$t"
    echo "linter gate self-test: PASS"
}

selftest_gates

read -r -d '' rpm_script <<'RPM_SCRIPT' || true
dnf -y install rpm-build golang gcc make git tar rpm cpio file rpmlint findutils
git config --global --add safe.directory /src
# Clear any rpm/ left by an earlier run; otherwise the find below could select
# a stale package instead of the one just built.
rm -rf rpm
make rpm

# journalpump-[0-9]* selects the main package, not the auto-generated
# -debuginfo / -debugsource subpackages.
rpmfile=$(find rpm/RPMS -name 'journalpump-[0-9]*.rpm' -print -quit)
test -n "$rpmfile" || { echo "no rpm produced"; exit 1; }

release=$(rpm -qp --qf '%{RELEASE}' "$rpmfile")
case "$release" in
    *golang*) ;;
    *) echo "release lacks the golang marker: $release"; exit 1 ;;
esac
arch=$(rpm -qp --qf '%{ARCH}' "$rpmfile")
test "$arch" != noarch || { echo "rpm is noarch: $arch"; exit 1; }
echo "rpm: $rpmfile  (release=$release arch=$arch)"

# Expected runtime payload manifest (the %doc files are additional).
rpmfiles=$(rpm -qlp "$rpmfile")
for want in /usr/bin/journalpump \
            /usr/lib/systemd/system/journalpump.service \
            /var/lib/journalpump \
            /var/lib/journalpump/journalpump.json; do
    grep -qx "$want" <<<"$rpmfiles" || { echo "rpm missing $want"; exit 1; }
done

# The Requires must carry the runtime soname the cgo reader dlopens.
rpmreqs=$(rpm -qp --qf '[%{REQUIRENAME}\n]' "$rpmfile")
grep -qx 'libsystemd.so.0()(64bit)' <<<"$rpmreqs" || {
    echo "rpm lacks the libsystemd.so.0 soname requirement"; exit 1;
}

# The default config must be a %config(noreplace) file (FILEFLAGS "cn") so an
# operator's edits survive an upgrade, matching the Debian conffile.
rpmcfg=$(rpm -qp --qf '[%{FILENAMES} %{FILEFLAGS:fflags}\n]' "$rpmfile" \
    | grep '/var/lib/journalpump/journalpump.json ' || true)
case "$rpmcfg" in
    *cn*) ;;
    *) echo "rpm config is not %config(noreplace): $rpmcfg"; exit 1 ;;
esac

work=$(mktemp -d)
cd "$work"
rpm2cpio "/src/$rpmfile" | cpio -idm --quiet
kind=$(file usr/bin/journalpump)
grep -q 'ELF' <<<"$kind" || { echo "packaged binary is not an ELF"; exit 1; }
# The plan requires the unit UNCHANGED: compare byte-for-byte.
cmp usr/lib/systemd/system/journalpump.service /src/journalpump.unit || {
    echo "shipped unit differs from journalpump.unit"; exit 1;
}
# The shipped default config must match the in-tree journalpump.default.json
# byte-for-byte, so the zero-config start is validated against the real file.
cmp var/lib/journalpump/journalpump.json /src/journalpump.default.json || {
    echo "shipped default config differs from journalpump.default.json"; exit 1;
}

rpmlint "/src/$rpmfile" >/tmp/rpmlint.out 2>&1 && rpm_rc=0 || rpm_rc=$?
echo "=== rpmlint output ==="; cat /tmp/rpmlint.out
echo "rpmlint exit status: $rpm_rc"
rpmlint_gate /tmp/rpmlint.out "$rpm_rc"
echo "rpmlint: clean (only the allowlisted technology-name spelling diagnostics)"
RPM_SCRIPT

# The gate functions are used inside the containers; pass their definitions
# and the allowlist constants (via -e) into each container's shell.
gates=$(declare -f _rc_allowed _unexpected_e _e_count rpmlint_gate lintian_gate)

read -r -d '' deb_script <<'DEB_SCRIPT' || true
export DEBIAN_FRONTEND=noninteractive
# dch (run by `make deb`) derives the changelog entry's author from
# DEBEMAIL/DEBFULLNAME, falling back to user@hostname; without these the
# generated changelog trips lintian's bogus-mail-host-in-debian-changelog.
# Use the package Maintainer from debian/control for a reproducible build.
export DEBEMAIL="hannu.valtonen@ohmu.fi"
export DEBFULLNAME="Hannu Valtonen"
apt-get update -qq
# Install the DECLARED Build-Depends (golang-go comes from the distro, whose
# GOTOOLCHAIN=auto fetches the go.mod-pinned toolchain) plus lintian/file for
# inspection.  ca-certificates is a build-time need here (the Go toolchain and
# modules are fetched over HTTPS); the RUNTIME ca-certificates dependency is
# checked by the install-and-start test, not here.
apt-get install -y -qq --no-install-recommends \
    build-essential debhelper devscripts golang-go gcc git ca-certificates lintian file
git config --global --add safe.directory /src
# Clone so dpkg-buildpackage writes its output into /build, not / (the
# parent of the mounted source).
git clone --quiet /src /build/journalpump
cd /build/journalpump
make deb < /dev/null

shopt -s nullglob
debs=(/build/journalpump_*.deb)
shopt -u nullglob
debfile=${debs[0]:-}
test -n "$debfile" || { echo "no deb produced"; exit 1; }

version=$(dpkg-deb -f "$debfile" Version)
case "$version" in
    *golang*) ;;
    *) echo "version lacks the golang marker: $version"; exit 1 ;;
esac
arch=$(dpkg-deb -f "$debfile" Architecture)
test "$arch" != all || { echo "deb is architecture-independent: $arch"; exit 1; }
echo "deb: $debfile  (version=$version arch=$arch)"

# Expected payload manifest.
debfiles=$(dpkg-deb -c "$debfile")
for want in usr/bin/journalpump usr/lib/systemd/system/journalpump.service \
            var/lib/journalpump/journalpump.json; do
    grep -qE "[[:space:]]\./$want\$" <<<"$debfiles" || { echo "deb missing $want"; exit 1; }
done

work=$(mktemp -d)
dpkg-deb -x "$debfile" "$work"
kind=$(file "$work/usr/bin/journalpump")
grep -q 'ELF' <<<"$kind" || { echo "packaged binary is not an ELF"; exit 1; }
# The plan requires the unit UNCHANGED: compare byte-for-byte.
cmp "$work/usr/lib/systemd/system/journalpump.service" /src/journalpump.unit || {
    echo "shipped unit differs from journalpump.unit"; exit 1;
}
# The shipped default config must match the in-tree journalpump.default.json
# byte-for-byte, so the zero-config start is validated against the real file.
cmp "$work/var/lib/journalpump/journalpump.json" /src/journalpump.default.json || {
    echo "shipped default config differs from journalpump.default.json"; exit 1;
}

# The adduser postinst must be shipped verbatim.
ctl=$(mktemp -d)
dpkg-deb -e "$debfile" "$ctl"
cmp "$ctl/postinst" /src/debian/postinst || {
    echo "shipped postinst differs from debian/postinst"; exit 1;
}

# The default config must be a dpkg CONFFILE so an operator's edits survive
# install-over and upgrade (matching the RPM %config(noreplace)).
grep -qx '/var/lib/journalpump/journalpump.json' "$ctl/conffiles" || {
    echo "deb does not mark the default config a conffile"; exit 1;
}

lintian "$debfile" >/tmp/lintian.out 2>&1 && deb_rc=0 || deb_rc=$?
echo "=== lintian output ==="; cat /tmp/lintian.out
echo "lintian exit status: $deb_rc"
lintian_gate /tmp/lintian.out "$deb_rc"
echo "lintian: clean (only the allowlisted non-etc-conffile diagnostic)"
DEB_SCRIPT

echo "== rpm =="
podman run --rm -v "$repo:/src:Z" -w /src \
    -e RPM_E_ALLOW="$RPM_E_ALLOW" -e DEB_E_ALLOW="$DEB_E_ALLOW" \
    -e RPM_ALLOWED_RC="$RPM_ALLOWED_RC" -e DEB_ALLOWED_RC="$DEB_ALLOWED_RC" \
    "$rpm_image" bash -euo pipefail -c "$gates; $rpm_script"

echo "== deb =="
podman run --rm -v "$repo:/src:Z" \
    -e RPM_E_ALLOW="$RPM_E_ALLOW" -e DEB_E_ALLOW="$DEB_E_ALLOW" \
    -e RPM_ALLOWED_RC="$RPM_ALLOWED_RC" -e DEB_ALLOWED_RC="$DEB_ALLOWED_RC" \
    "$deb_image" bash -euo pipefail -c "$gates; $deb_script"

echo "check-packaging: PASS"